# Per-machine settings srpub picks up. Set before sourcing bashrc.
#   GIT_TRUNK   trunk to branch from / rebase onto, when it isn't the
#               remote's HEAD (e.g. export GIT_TRUNK=origin/develop)
# export GIT_TRUNK=origin/develop

echo "Loading srpub/bashrc"
source ~/srpub/bashrc
echo "Loading secretsrc"
source ~/.secretsrc

alias ls="ls -G"

# initialize brew - is there a better way??
eval "$(/opt/homebrew/bin/brew shellenv)"

# dont share history across terminal sessions
unsetopt SHARE_HISTORY
setopt NO_SHARE_HISTORY
